# ============================================
# PromoHub Web App Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# For full documentation, see the root .env.example
# ============================================

# ============================================
# PUBLIC VARIABLES (bundled into client-side code)
# ============================================

# Supabase (2025+ key format: sb_publishable_... / sb_secret_...)
# Get keys from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# SECRET VARIABLES (server-side only)
# ============================================

# Supabase Admin (use sparingly - bypasses RLS)
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Payments (Korea)
TOSS_CLIENT_KEY=test_ck_your-toss-client-key
TOSS_SECRET_KEY=test_sk_your-toss-secret-key

# Payments (Global)
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
KAKAO_ALIMTALK_KEY=your-kakao-alimtalk-api-key
KAKAO_ALIMTALK_SENDER=your-registered-sender-key

# External APIs (Phase 2+)
COUPANG_ACCESS_KEY=your-coupang-access-key
COUPANG_SECRET_KEY=your-coupang-secret-key
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
